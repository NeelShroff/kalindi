HOST=127.0.0.1
PORT=8088
DATABASE_URL=sqlite:///./database.db
JWT_SECRET=your_jwt_secret_key_here_make_it_long_and_random
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Environment: "development" enables mock payments; "production" enforces full security
APP_ENV=development

# Admin Credentials (CHANGE THESE before deploying to production!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Email SMTP Settings (for Gmail, App Password is required)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SENDER_EMAIL=your_email@gmail.com
OWNER_EMAIL=your_email@gmail.com

# Groq API Key for Luxury AI Concierge
GROQ_API_KEY=your_groq_api_key_here

# Google OAuth Client ID (required for secure Google JWT verification in production)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
